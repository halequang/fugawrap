{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FugaWrap",
  "version": "0.1.0",
  "identifier": "shop.fungamingvn.fugawrap",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FugaWrap",
        "width": 420,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "FunGaming (fungamingvn)",
    "icon": ["../src/assets/icon.png", "../build/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
